# ===== 运行环境 =====
ENVIRONMENT=prod
SECRET_KEY=请替换为随机长串
PUBLIC_BASE_URL=https://portal.jc-digital.cn
DATABASE_URL=postgresql+psycopg://jucheng:密码@db:5432/jucheng

# ===== 数据源模式 mock | live；可按源覆盖 wecom:live,lemoncloud:mock =====
DATA_SOURCE_MODE=live
DATA_SOURCE_OVERRIDES=

# ===== 登录 =====
PASSWORD_LOGIN_ENABLED=false
DEMO_PASSWORD=

# ===== 企业微信自建应用 =====
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ===== 柠檬云 / 腾讯乐享 =====
LEMONCLOUD_APP_ID=
LEMONCLOUD_APP_SECRET=
LEXIANG_APP_KEY=
LEXIANG_APP_SECRET=

# ===== 大模型（OpenAI 兼容：混元/DeepSeek 等），不配置则方案生成走规则引擎 =====
# DeepSeek V4.1 Flash：BASE_URL=https://api.deepseek.com，MODEL=deepseek-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 使用 DeepSeek 时可设 disabled；留空则不向服务发送 thinking 参数
LLM_THINKING_MODE=

# ===== 小聚本机执行器：本机部署时启用，运行环境应与 WorkBuddy 所在电脑一致 =====
ASSISTANT_HOST_ACCESS=false
# 留空不需要设置；默认使用进程用户的主目录
# ASSISTANT_HOST_HOME=/home/your-user
ASSISTANT_TASK_TIMEOUT_SECONDS=300

# ===== MCP =====
MCP_RATE_LIMIT_PER_MIN=60
MCP_ALLOWED_HOSTS=portal.jc-digital.cn
