# ===== 运行环境 =====
ENVIRONMENT=prod
SECRET_KEY=请替换为随机长串
PUBLIC_BASE_URL=https://portal.jc-digital.cn
DATABASE_URL=postgresql+psycopg://jucheng:密码@db:5432/jucheng

# ===== 数据源模式 mock | live；可按源覆盖 wecom:live,lemoncloud:mock =====
DATA_SOURCE_MODE=live
DATA_SOURCE_OVERRIDES=

# ===== 登录 =====
PASSWORD_LOGIN_ENABLED=false
DEMO_PASSWORD=

# ===== 企业微信自建应用 =====
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ===== 柠檬云 / 腾讯乐享 =====
LEMONCLOUD_APP_ID=
LEMONCLOUD_APP_SECRET=
LEXIANG_APP_KEY=
LEXIANG_APP_SECRET=

# ===== 大模型（OpenAI 兼容：混元/DeepSeek 等），不配置则方案生成走规则引擎 =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== MCP =====
MCP_RATE_LIMIT_PER_MIN=60
MCP_ALLOWED_HOSTS=portal.jc-digital.cn
