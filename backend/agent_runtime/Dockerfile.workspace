FROM node:22-bookworm-slim
COPY --from=docker:26-cli /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG APT_MIRROR=
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|http://deb.debian.org/debian|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; fi \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates bash ripgrep git python3 python3-openpyxl python3-docx python3-pil && rm -rf /var/lib/apt/lists/*
WORKDIR /runtime
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund --registry=$NPM_REGISTRY
COPY workspace.mjs ./
USER 10001:10001
WORKDIR /workspace
CMD ["node", "/runtime/workspace.mjs"]
