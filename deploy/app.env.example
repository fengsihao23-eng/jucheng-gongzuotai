# 生产环境变量模板：复制为 app.env 并填入真实值（deploy.sh 会安装到服务器 backend/.env）
ENVIRONMENT=prod
SECRET_KEY=请替换为 openssl rand -hex 32
PUBLIC_BASE_URL=https://juchengcc.com
# DATABASE_URL 由 docker-compose 注入

DATA_SOURCE_MODE=mock
DATA_SOURCE_OVERRIDES=

PASSWORD_LOGIN_ENABLED=true
DEMO_PASSWORD=请替换为强口令
# 生产演示期在登录页展示演示账号下拉（切 live 后设为 false）
DEMO_ACCOUNTS_ENABLED=true

WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

LEMONCLOUD_APP_ID=
LEMONCLOUD_APP_SECRET=
LEXIANG_APP_KEY=
LEXIANG_APP_SECRET=

LLM_BASE_URL=https://ai.ctaigw.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
# 扫描件/图片逐页识别：留空沿用 LLM_MODEL（同一网关与密钥），只在需要换视觉模型时填写
LLM_VISION_MODEL=
# 单份资料最多识别多少页/张图；超限明确拒绝，不静默截断
LLM_VISION_MAX_PAGES=30
LLM_THINKING_MODE=disabled

ASSISTANT_HOST_ACCESS=false
ASSISTANT_TASK_TIMEOUT_SECONDS=300

MCP_RATE_LIMIT_PER_MIN=60
MCP_ALLOWED_HOSTS=juchengcc.com,www.juchengcc.com
